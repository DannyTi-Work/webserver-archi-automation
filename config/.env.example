# Template for local secrets — copy to config/.env or the repo-root .env,
# set mode 600, and never commit the real file.
#
# Domain databases/passwords are created by add-domain.sh. You can pre-set a
# password per domain here (variables are normalised: dots and dashes -> _).
# Example for test1.example.com -> DB_PASS_test1_example_com / DB_USER_test1_example_com

# Default DB user prefix per domain (optional; generated if not set)
DB_USER_PREFIX=

# Optional: per-domain password, e.g.:
# DB_PASS_test1_example_com=some-long-random-password

# Optional: SSH details for terminal access from the dev machine (not used by
# the VPS-local installer, which runs on the VPS itself).
# SSH_HOST=
# SSH_PASSWORD=
