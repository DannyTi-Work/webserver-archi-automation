# config/panel.conf.example — Web admin panel options (Phase 8).
#
# Install on the VPS:
#   cp config/panel.conf.example config/panel.conf
#   chmod 600 config/panel.conf
#   $EDITOR config/panel.conf
#   bash scripts/setup-panel.sh          # Step 5 of Phase 8
#
# The real config/panel.conf is gitignored. Never commit it — it holds
# the settings and paths that gate a publicly reachable admin endpoint.

# ---------------------------------------------------------------------------
# Listener / hostname
# ---------------------------------------------------------------------------
# Apex domain whose EXISTING Let's Encrypt certificate is reused on this port.
# It must already resolve to this VPS and have a cert issued by tls.sh.
# The panel is reached at https://${PANEL_DOMAIN}:${PANEL_PORT}${ADMIN_PATH}/
PANEL_DOMAIN="example.com"

# Public listener port for the panel.
PANEL_PORT="8083"

# Unguessable URL path for the panel entry files.
ADMIN_PATH="/_wsa-admin"

# PHP-FPM socket used by the panel location. Leave empty to auto-detect.
PHP_FPM_SOCKET=""

# ---------------------------------------------------------------------------
# Authentication — Basic Auth is the only gate (no IP allowlist)
# ---------------------------------------------------------------------------
BASIC_AUTH_USER="admin"

# bcrypt htpasswd file, generated by setup-panel.sh (root:www-data 0640).
# nginx worker processes read it as www-data.
HTPASSWD_FILE="/etc/nginx/.wsa-panel-htpasswd"

# CSRF / session signing secret, generated once (root:www-data 0640 so
# PHP-FPM can read it). Never reuse the SSH password here.
SESSION_SECRET_FILE="/etc/wsa/panel-session.key"

# ---------------------------------------------------------------------------
# Brute-force protection for the public :8083 listener
# ---------------------------------------------------------------------------
# limit_req rate for panel PHP endpoints (zone is defined in the vhost).
RATE_LIMIT_RATE="10r/m"

# fail2ban jail for repeated 401s on the panel error log (0 disables it).
FAIL2BAN_ENABLED="1"
FAIL2BAN_MAXRETRY="5"
FAIL2BAN_FINDTIME="600"
FAIL2BAN_BANTIME="3600"

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
# Panel PHP lives outside every site docroot.
PANEL_ROOT="/srv/wsa-panel/public"

# Shared WordPress template used by the Fetch WordPress package action.
WP_TEMPLATE_DIR="/var/lib/wsa/wordpress"

PANEL_ACCESS_LOG="/var/log/nginx/wsa-panel.access.log"
PANEL_ERROR_LOG="/var/log/nginx/wsa-panel.error.log"

# Persistent action log: every panel action appends one JSON line here,
# for both successes and failures. The dashboard reads the last 30 entries.
# setup-panel.sh creates the directory (root:www-data 0750) so PHP can append.
ACTION_LOG="/var/log/wsa-panel/actions.log"

# sudoers drop-in rendered from config/sudoers-panel.conf.example by setup-panel.sh.
SUDOERS_FILE="/etc/sudoers.d/wsa-panel"
